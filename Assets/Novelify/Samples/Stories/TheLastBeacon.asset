          width: 479
          height: 163
        typeName: NovelGraph.DialogueNode, NovelGraph.Runtime, Version=0.0.0.0, Culture=neutral,
          PublicKeyToken=null
        speaker: Mira
        dialogue: Good. Then this is our light, not mine. Stay close and keep above
          the flood marks.
    - rid: 1574623318951592013
      type: {class: TwoChoiceNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
