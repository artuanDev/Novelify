          width: 240
          height: 160
        typeName:
        speakerMode: 2
        character: {fileID: 11400000, guid: bca8cafe64d9d704a8dbc48052ce21b7, type: 2}
        speaker:
        dialogue: I will hold the cable. Mira, take the battery up and do not look
          down.
        playLetterSounds: 1
        charactersPerSecond: 32
    - rid: 1574623319563960329
      type: {class: CallFunctionNode, ns: NovelGraph, asm: NovelGraph.Runtime}
