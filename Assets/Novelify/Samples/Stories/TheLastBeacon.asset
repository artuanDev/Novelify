          y: 278
          width: 524
          height: 163
        typeName: NovelGraph.DialogueNode, NovelGraph.Runtime, Version=0.0.0.0, Culture=neutral,
          PublicKeyToken=null
        speaker: Mira
        dialogue: The tide has covered the lower road. Give me the battery and I
          can still reach the tower.
    - rid: 1574623318951592011
      type: {class: TwoChoiceNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
