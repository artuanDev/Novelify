          height: 160
        typeName:
        speakerMode: 2
        character: {fileID: 11400000, guid: 6f5170830e0f52d4397753d7da3688fb, type: 2}
        speaker:
        dialogue: The beacon is alive. Look at the water, Elias. The ships can see
