        typeName: NovelGraph.DialogueNode, NovelGraph.Runtime, Version=0.0.0.0, Culture=neutral,
          PublicKeyToken=null
        speaker: Narrator
        dialogue: At the edge of a drowned city, the last beacon wakes for one final
          night.
    - rid: 1574623318951592010
      type: {class: DialogueNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
        m_guid: 1b4b5a40-dc00-4de7-bc98-1946e51741f8
