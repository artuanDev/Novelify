        typeName: NovelGraph.TwoChoiceNode, NovelGraph.Runtime, Version=0.0.0.0,
          Culture=neutral, PublicKeyToken=null
        prompt: 'At the tower, the storm is almost overhead. When should Mira ignite
          the beacon? '
        firstChoice: Light it now, before the storm breaks
        firstSignal: beacon_lit
        firstValue: 1
        secondChoice: Wait for a ship to answer the radio
        secondSignal: beacon_waited
        secondValue: 0
        stateKey: beacon_lit_early
