          height: 163
        typeName: NovelGraph.DialogueNode, NovelGraph.Runtime, Version=0.0.0.0, Culture=neutral,
          PublicKeyToken=null
        speaker: Narrator
        dialogue: Amber light rolls across the black water. Far beyond the rain,
          three ships answer in sequence.
