          height: 160
        typeName:
        speakerMode: 1
        character: {fileID: 0}
        speaker:
        dialogue: At the edge of a drowned city, the last beacon wakes for one final
          night.
        playLetterSounds: 0
        charactersPerSecond: 42
    - rid: 1574623319563960322
      type: {class: DialogueNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
        m_guid: f57b7947-d759-4100-8ea0-a1852f1de660
        m_position:
          serializedVersion: 2
          x: 560
          y: 340
          width: 240
          height: 160
        typeName:
        speakerMode: 2
        character: {fileID: 11400000, guid: 6f5170830e0f52d4397753d7da3688fb, type: 2}
        speaker:
        dialogue: The lower road is gone. Give me the battery and I can still reach
          the tower before the storm.
        playLetterSounds: 1
        charactersPerSecond: 36
    - rid: 1574623319563960323
      type: {class: DialogueNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
        m_guid: 25eb2f4e-7988-4e72-8ace-5a9d02534fe6
        m_position:
          serializedVersion: 2
          x: 840
          y: 340
          width: 240
          height: 160
        typeName:
        speakerMode: 2
        character: {fileID: 11400000, guid: bca8cafe64d9d704a8dbc48052ce21b7, type: 2}
        speaker:
        dialogue: Mira, the harbor sensors just failed. Whatever we choose, we choose
          it now.
        playLetterSounds: 1
        charactersPerSecond: 30
    - rid: 1574623319563960324
      type: {class: TwoChoiceNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
        m_guid: e3fbd887-310d-4697-948f-9b2bf3abc782
        m_position:
          serializedVersion: 2
          x: 1120
          y: 340
          width: 240
          height: 160
        typeName:
        prompt: Mira holds out her hand. What do you do?
        firstChoice: Trust Mira with the battery
        firstSignal: mira_trusted
        firstValue: 1
        secondChoice: Keep the battery and turn back
        secondSignal: mira_refused
        secondValue: 0
        stateKey: trusted_mira
    - rid: 1574623319563960325
      type: {class: DialogueNode, ns: NovelGraph, asm: NovelGraph.Runtime}
      data:
        m_guid: 62725e4e-e3bd-4280-a63c-416d8123f9e7
        m_position:
          serializedVersion: 2
          x: 1440
          y: 60
          width: 240
          height: 160
        typeName:
        speakerMode: 2
        character: {fileID: 11400000, guid: 6f5170830e0f52d4397753d7da3688fb, type: 2}
        speaker:
        dialogue: Good. Then this is our light, not mine. Stay close and keep above
          the flood marks.
        playLetterSounds: 1
        charactersPerSecond: 38
    - rid: 1574623319563960326
      type: {class: CallFunctionNode, ns: NovelGraph, asm: NovelGraph.Runtime}
